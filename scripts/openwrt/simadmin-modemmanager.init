#!/bin/sh /etc/rc.common
START=98
STOP=11
USE_PROCD=1

start_service() {
	. /usr/lib/simadmin/openwrt-common.sh
	config_load simadmin
	local enabled binary
	config_get_bool enabled modemmanager enabled 0
	[ "$enabled" = 1 ] || return 0
	config_get binary modemmanager binary /usr/sbin/ModemManager
	[ -x "$binary" ] || { simadmin_error "Missing ModemManager executable: $binary"; return 1; }
	for tool in dbus-send ubus jsonfilter pidof mmcli readlink awk date; do
		command -v "$tool" >/dev/null 2>&1 || { simadmin_error "Missing runtime tool: $tool"; return 1; }
	done
	[ -r /lib/udev/rules.d/78-mm-simadmin-rg200u.rules ] || { simadmin_error 'Missing restricted RG200U port rules'; return 1; }
	. /usr/lib/simadmin/modemmanager-ports.sh
	simadmin_mm_validate_ports || return 1
	simadmin_require_bus || return 1
	simadmin_require_service_bus || return 1
	simadmin_require_no_competing_services || return 1
	if simadmin_mm_has_owner || pidof ModemManager >/dev/null 2>&1; then
		simadmin_error 'Another ModemManager already owns the modem; refusing a second instance.'
		return 1
	fi
	procd_open_instance main
	procd_set_param command /usr/lib/simadmin/modemmanager-wrapper.sh "$binary"
	procd_set_param env DBUS_SYSTEM_BUS_ADDRESS=unix:path=/var/run/dbus/system_bus_socket
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 20
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger simadmin
}
