config simadmin 'main'
	# Packaging is inert until explicitly enabled during a later deployment.
	option enabled '0'
	option binary '/opt/simadmin/simadmin'
	option data_dir '/opt/simadmin/data'
	option host '127.0.0.1'
	option port '3000'
	option modem_service 'simadmin-modemmanager'
	option network_interface 'wwan_5g_0'
	option ipv6_network_interface 'wwan6_5g_0'
	option network_device 'usb0'
	option apn '3gnet'

config modemmanager 'modemmanager'
	option enabled '0'
	option binary '/usr/sbin/ModemManager'
