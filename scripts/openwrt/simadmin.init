#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1

start_service() {
	. /usr/lib/simadmin/openwrt-common.sh
	config_load simadmin
	local enabled binary data_dir host port modem_service network_interface ipv6_network_interface network_device apn
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0
	config_get binary main binary /opt/simadmin/simadmin
	config_get data_dir main data_dir /opt/simadmin/data
	config_get host main host 127.0.0.1
	config_get port main port 3000
	config_get modem_service main modem_service simadmin-modemmanager
	case "$modem_service" in simadmin-modemmanager|modemmanager|ModemManager) ;;
		*) simadmin_error 'modem_service must name a supported MM service'; return 1 ;;
	esac
	config_get network_interface main network_interface wwan_5g_0
	config_get ipv6_network_interface main ipv6_network_interface wwan6_5g_0
	config_get network_device main network_device usb0
	config_get apn main apn 3gnet
	[ -x "$binary" ] || { simadmin_error "Missing executable: $binary"; return 1; }
	for tool in dbus-send ubus jsonfilter; do
		command -v "$tool" >/dev/null 2>&1 || { simadmin_error "Missing runtime tool: $tool"; return 1; }
	done
	simadmin_require_bus || return 1
	simadmin_require_service_bus || return 1
	# Existing MM services may be explicitly selected; the legacy AT dialer may not.
	if [ "$modem_service" = simadmin-modemmanager ]; then
		simadmin_require_no_competing_services || return 1
	else
		simadmin_require_stopped_service modem || return 1
	fi
	simadmin_wait_for_mm || return 1
	case "$data_dir" in /*) ;; *) simadmin_error 'data_dir must be absolute'; return 1 ;; esac
	mkdir -p "$data_dir" || return 1
	chmod 700 "$data_dir" || return 1
	procd_open_instance main
	procd_set_param command "$binary" serve --host "$host" --port "$port"
	procd_set_param env SIMADMIN_PLATFORM=openwrt SIMADMIN_DATA_DIR="$data_dir" \
		SIMADMIN_MODEM_SERVICE="$modem_service" \
		DBUS_SYSTEM_BUS_ADDRESS=unix:path=/var/run/dbus/system_bus_socket \
		SIMADMIN_NETWORK="$network_interface" SIMADMIN_IPV6_NETWORK="$ipv6_network_interface" \
		SIMADMIN_INTERFACE="$network_device" \
		SIMADMIN_APN="$apn"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 20
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger simadmin
}
